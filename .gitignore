# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.pyc

# Quarto build artifacts. The rendered report is written to output/ and is
# regenerated on every run, so it is never committed.
_site/
*_cache/
*_files/
.quarto/
*.html
*.pdf

# Generated output. The pipeline rebuilds the analytic file and the rendered
# report from the committed panel, so neither is tracked. km_curve.png is the
# exception: README.md embeds it, so it must be tracked for GitHub to show it.
output/*
!output/km_curve.png

# remove sythetic data generator
/make_synthetic_data.py

# OS cruft
.DS_Store
Thumbs.db
